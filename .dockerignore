# =============================================================================
#  Docker build context (WO-22) — governs both images, built from the root.
#  Next's standalone tracer copies env files it finds; without these rules an
#  image would carry the production Neon URL and JWT_SECRET in a layer.
# =============================================================================

# --- Secrets. Keep this block first and do not weaken it. --------------------
#  .dockerignore is NOT .gitignore: a bare `.env` matches only the root, so
#  every pattern needs `**/` to apply at depth.
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.render.example
!.env.vercel.example
.envrc
**/.envrc
.sentryclirc
**/.sentryclirc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/secrets/
**/credentials/

# --- Database dumps: member PII, and large. ----------------------------------
backups/
*.dump
*.dump.gpg
*.sqlite
*.sqlite3

# --- Reinstalled inside the image from the lockfile. -------------------------
node_modules
**/node_modules
.pnpm-store

# --- Build outputs. A host .next/ leaking in produces a container serving a
#     stale build that no source change explains. ----------------------------
.next
**/.next
out
dist
build
**/*.tsbuildinfo

# --- Go build artefacts. Rebuilt in the builder stage. -----------------------
bin/
apps/api/server
apps/api/app
**/*.test
**/*.out

# --- Not needed to build or run. ---------------------------------------------
.git
.gitignore
.github
.githooks
.gitleaks.toml
docs
*.md
!apps/web/README.md
LICENSE
test-results
playwright-report
playwright/.cache
coverage
.vscode
.idea
.claude
.agents
docker-compose.yml
docker-compose.override.yml
