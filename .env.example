# Hasnahena environment
# Copy to .env.local and fill in. Never commit the filled copy.
# One file at the repo root serves both apps: Next reads it, and the Go API
# walks up from apps/api looking for .env / .env.local.
# Docs: docs/setup.md

# --- Required ------------------------------------------------------------

# Local Docker postgres; in production use the POOLED Neon URL at runtime
# and the DIRECT (no -pooler) URL for `pnpm db:push`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hasnahena_dev

# Minimum 32 characters. Must be IDENTICAL for web and API or every
# dashboard request 401s. The API refuses to start if this is too short.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Where the browser reaches the Go API.
NEXT_PUBLIC_API_URL=http://localhost:8081

# Go API. PORT is accepted as a fallback (Render sets it).
API_PORT=8081

# Comma-separated, no spaces. Must include every origin that calls the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Email (Brevo, backend only) -----------------------------------------
# Unset = email disabled: approval and password-reset mails are skipped and
# /v1/health reports emailConfigured:false. Everything else still works.
# EMAIL_FROM must be a Brevo-verified sender.
BREVO_API_KEY=
EMAIL_FROM=info@hasnahenafoundation.com
EMAIL_FROM_NAME=Hasnahena Foundation

# Public app URL used in email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- File storage (Cloudinary) -------------------------------------------
# Unset = uploads fail, all other flows work. Use a dev account or a
# hasnahena-dev/ folder prefix locally; never production credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional tuning ------------------------------------------------------
JWT_EXPIRY_SECONDS=86400
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_MAX_CONN_IDLE_TIME=5m
DB_MAX_CONN_LIFETIME=30m
DB_HEALTH_CHECK_PERIOD=1m
