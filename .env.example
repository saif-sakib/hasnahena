# ===========================================================================
#  LOCAL DEVELOPMENT  —  copy this to .env.local
# ===========================================================================
#  There is ONE env file for local work: .env.local at the repo root.
#
#    * Go API      — its loader walks up from apps/api and finds it
#    * Next/Prisma — apps/web/.env is a symlink to it
#
#  If apps/web/.env is missing (fresh clone, or Windows), recreate it:
#      ln -s ../../.env.local apps/web/.env
#
#  PRODUCTION VALUES DO NOT GO HERE. They live in the host dashboards, which
#  are separate stores that share nothing:
#      Go API   -> Render   -> .env.render.example
#      Web app  -> Vercel   -> .env.vercel.example
#
#  Only DATABASE_URL and JWT_SECRET are shared between the two hosts, and both
#  must match byte for byte.
# ===========================================================================

# --- Required by BOTH apps --------------------------------------------------
# Local Postgres from docker-compose.yml:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hasnahena_dev

# Optional. Only `pnpm db:migrate` and pg_dump use it, and only Neon needs it:
# the pooled (-pooler) host cannot hold the session lock migrations take. Leave
# it blank locally — db:migrate derives it from DATABASE_URL and logs that it did.
DIRECT_DATABASE_URL=

# Minimum 32 characters or the Go API refuses to boot. Any random string
# locally, but the SAME string for both apps.
JWT_SECRET=local-development-secret-at-least-32-characters-long

# --- Go API -----------------------------------------------------------------
API_PORT=8081
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_EXPIRY_SECONDS=86400
LOG_LEVEL=debug

# --- Web app ----------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudinary (uploads) ---------------------------------------------------
# Unset = uploads fail, every other flow works. Use a dev account or a
# hasnahena-dev/ folder prefix locally; never production credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Brevo, Go API only) ---------------------------------------------
# Unset = email disabled: approval and reset mails are skipped and
# /v1/health reports emailConfigured:false. Fine for local work.
BREVO_API_KEY=
EMAIL_FROM=info@hasnahenafoundation.com
EMAIL_FROM_NAME=Hasnahena Foundation

# --- Optional tuning (working defaults; uncomment only to change) -----------
# DB_MAX_CONNS=25
# DB_MIN_CONNS=0            # 0 lets the pool empty so a scale-to-zero database can suspend
# DB_MAX_CONN_IDLE_TIME=60s # shorter than the host suspend timer, so it is not reset
# DB_MAX_CONN_LIFETIME=30m
# DB_HEALTH_CHECK_PERIOD=5m # a backstop, not a heartbeat
# SERVER_READ_HEADER_TIMEOUT=10s
# SERVER_READ_TIMEOUT=30s
# SERVER_WRITE_TIMEOUT=60s
# SERVER_IDLE_TIMEOUT=120s
# SERVER_SHUTDOWN_TIMEOUT=30s
# CLEANUP_INTERVAL=24h      # every tick is a database wake

# --- Local scripts and tests ------------------------------------------------
# Which admin `pnpm db:clear` preserves.
KEEP_ADMIN_EMAIL=admin@hasnahena.local

# `pnpm test:e2e` skips every spec unless the last two are set. Point them at a
# seeded LOCAL database — the specs sign in and move money.
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_IDENTIFIER=
E2E_ADMIN_PASSWORD=

# `pnpm db:seed` refuses to invent an admin password. Minimum 12 characters.
# Not read by either app at runtime — only by the seed script.
SEED_ADMIN_EMAIL=admin@hasnahena.local
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_PHONE=01700000000
# SEED_ADMIN_NAME=System Administrator

# `pnpm test:integration` TRUNCATES every table between tests. Never point this
# at a database you care about.
TEST_DATABASE_URL=

# `scripts/backup.sh` / `scripts/restore-check.sh`. In CI these are the repo
# secrets BACKUP_DATABASE_URL and BACKUP_PASSPHRASE — see .github/workflows/backup.yml.
BACKUP_PASSPHRASE=

# --- Observability (Batch E) -------------------------------------------------
# All optional locally. Unset means /metrics 404s and Sentry is inert.
# METRICS_TOKEN=local-metrics-token
# METRICS_REFRESH_INTERVAL=10m  # the FLOOR between lazy refreshes, not a tick
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
