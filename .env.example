# ============================================================
# Hasnahena Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV=development
APP_NAME=Hasnahena
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/hasnahena_dev
DATABASE_POOL_SIZE=10

# For production, use connection pooling:
# DATABASE_URL=postgresql://user:password@host:5432/hasnahena?pgbouncer=true

# ------------------------------------------------------------
# Redis / Valkey (Cache)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
# Option 1: Clerk (Recommended for MVP)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Option 2: NextAuth / Auth.js
# NEXTAUTH_SECRET=your-secret-key-min-32-chars
# NEXTAUTH_URL=http://localhost:3000

# JWT Configuration (for Go API)
JWT_SECRET=your-jwt-secret-min-32-characters-long
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# ------------------------------------------------------------
# SMS Gateway (Bangladesh)
# ------------------------------------------------------------
# SSL Wireless
SMS_PROVIDER=sslwireless
SMS_API_TOKEN=your-sslwireless-token
SMS_SID=HASNAHENA
SMS_API_URL=https://smsplus.sslwireless.com/api/v3

# Alternative: Reve SMS
# SMS_PROVIDER=reve
# SMS_API_KEY=your-reve-api-key
# SMS_SECRET_KEY=your-reve-secret

# ------------------------------------------------------------
# Email (Transactional)
# ------------------------------------------------------------
# Resend (Recommended)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=noreply@hasnahena.org

# Alternative: SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password

# ------------------------------------------------------------
# File Storage
# ------------------------------------------------------------
# Cloudinary (MVP)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx

# AWS S3 (Production)
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=hasnahena-documents

# ------------------------------------------------------------
# NID Verification (Bangladesh)
# ------------------------------------------------------------
# Porichoy API
PORICHOY_API_KEY=your-porichoy-api-key
PORICHOY_API_URL=https://api.porichoybd.com/api/v1

# ------------------------------------------------------------
# Monitoring & Logging
# ------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# Sentry (Error Tracking)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------
FEATURE_NID_VERIFICATION=false
FEATURE_SMS_NOTIFICATIONS=true
FEATURE_EMAIL_NOTIFICATIONS=true

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Session Configuration
SESSION_SECRET=your-session-secret-min-32-chars
SESSION_MAX_AGE=86400

# ------------------------------------------------------------
# Java Ledger Service (Spring Boot)
# ------------------------------------------------------------
LEDGER_SERVICE_URL=http://localhost:8081
LEDGER_SERVICE_GRPC_PORT=9090

# Spring Boot specific
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hasnahena_dev
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

# ------------------------------------------------------------
# Development Only
# ------------------------------------------------------------
# Disable HTTPS redirect in development
DISABLE_HTTPS_REDIRECT=true

# Enable debug endpoints
ENABLE_DEBUG_ENDPOINTS=true

# Seed data on startup
SEED_DATABASE=true
