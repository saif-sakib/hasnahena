# Hasnahena .gitignore

# ------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------
node_modules/
.pnpm-store/
vendor/

# ------------------------------------------------------------
# Build outputs
# ------------------------------------------------------------
.next/
# The test stack builds into its own directory so it can run beside `pnpm dev`
# (Next 16 locks the output directory against a second dev server).
.next-test/
out/
build/
dist/
*.exe
*.dll
*.so
*.dylib

# Go server binaries (a 17 MB one was committed once).
bin/
apps/api/server
apps/api/app
# `go test -c` binaries and coverage profiles.
*.test
*.out

# ------------------------------------------------------------
# Environment files
# ------------------------------------------------------------
# Deny every .env*, then re-allow the templates by name.
.env
.env.*
!.env.example
!.env.render.example
!.env.vercel.example

# direnv. Same content as .env.local, different filename.
.envrc

# Written by `npx @sentry/wizard` and by `sentry-cli login`. Contains an auth
# token that can read source maps and issues for the whole Sentry org.
.sentryclirc

# ------------------------------------------------------------
# IDE, editor and agent tooling
# ------------------------------------------------------------
.idea/
.vscode/
# Per-machine tool permissions and MCP credentials. .claude/settings.json (no
# `.local`) is shareable and stays tracked if it is ever added.
.claude/settings.local.json
.mcp.local.json
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# Testing
# ------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
playwright/.cache/

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
# prisma/migrations/ (incl. migration_lock.toml) is COMMITTED — migrate deploy needs the lock file.

# ------------------------------------------------------------
# Cache
# ------------------------------------------------------------
.cache/
.parcel-cache/
.turbo/
.vercel/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Generated by next dev/build/typegen, each differently; Next says never track it.
# It stays in tsconfig `include` (tsc tolerates a missing listed file).
next-env.d.ts

# ------------------------------------------------------------
# Secrets and credentials
# ------------------------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------
tmp/
temp/
*.tmp
*.temp
*.bak

# ------------------------------------------------------------
# Documentation build
# ------------------------------------------------------------
docs/_build/
site/

# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------
# Per-machine overrides (ports, mounts, secrets).
docker-compose.override.yml

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
*.pid
*.seed
*.pid.lock
.npm/
.yarn/

# Local database dumps — never commit one, they contain member PII.
backups/
*.dump
*.dump.gpg
.test-stack/

# Foundation records were once committed here (ADR-018). Never again.
Official Infos/
