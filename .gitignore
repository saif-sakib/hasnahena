# ============================================================
# Hasnahena .gitignore
# ============================================================

# ------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------
node_modules/
.pnpm-store/
vendor/

# ------------------------------------------------------------
# Build outputs
# ------------------------------------------------------------
.next/
out/
build/
dist/
*.exe
*.dll
*.so
*.dylib

# Go — compiled server binaries. `go build` drops these next to the source,
# and a 17 MB artifact was committed once already.
bin/
apps/api/server
apps/api/app
# `go test -c` binaries and coverage profiles.
*.test
*.out

# ------------------------------------------------------------
# Environment files
# ------------------------------------------------------------
# Deny everything named .env*, then re-allow the templates by name. The old
# list-what-to-ignore approach left .env.production, .env.development and
# .env.test committable — every one of those is a file people really do create,
# and the first would have been the production database URL and JWT secret.
.env
.env.*
!.env.example
!.env.render.example
!.env.vercel.example

# direnv. Same content as .env.local, different filename.
.envrc

# Written by `npx @sentry/wizard` and by `sentry-cli login`. Contains an auth
# token that can read source maps and issues for the whole Sentry org.
.sentryclirc

# ------------------------------------------------------------
# IDE, editor and agent tooling
# ------------------------------------------------------------
.idea/
.vscode/
# Per-machine tool permissions and MCP credentials. .claude/settings.json (no
# `.local`) is shareable and stays tracked if it is ever added.
.claude/settings.local.json
.mcp.local.json
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# Testing
# ------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
playwright/.cache/

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
# NOTE: prisma/migrations/ is COMMITTED, migration_lock.toml included. An
# earlier rule ignored that lock file; it never fired only because the path was
# anchored at the repo root and the schema lives in apps/web. Prisma refuses to
# run `migrate deploy` against a migrations directory with no lock file, so
# ignoring it would have broken every deploy the day someone moved the app.

# ------------------------------------------------------------
# Cache
# ------------------------------------------------------------
.cache/
.parcel-cache/
.turbo/
.vercel/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ------------------------------------------------------------
# Secrets and credentials
# ------------------------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------
tmp/
temp/
*.tmp
*.temp
*.bak

# ------------------------------------------------------------
# Documentation build
# ------------------------------------------------------------
docs/_build/
site/

# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------
# The override file is where local-only ports, mounts and secrets go, so it is
# per-machine by design. docker-compose.yml and the Dockerfiles are committed.
docker-compose.override.yml

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
*.pid
*.seed
*.pid.lock
.npm/
.yarn/

# Local database dumps — never commit one, they contain member PII.
backups/
*.dump
*.dump.gpg
