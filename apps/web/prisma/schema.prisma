generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  MEMBER
  WORKER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum MaritalStatus {
  UNMARRIED
  MARRIED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  DONATION
  FEE
}

enum TransactionStatus {
  PENDING
  PROCESSED
  CONFIRMED
  REJECTED
  DISPUTED
  REVERSED
}

/// The loan lifecycle only (legacy PENDING/APPROVED collapsed by WO-71).
enum LoanStatus {
  // Application, in order.
  PENDING_GUARANTOR
  PENDING_APPROVAL
  ACTIVE

  // Settlement/closure.
  COMPLETED
  SETTLED

  // Risk outcomes.
  DEFAULTED
  REJECTED
}

// ============================================================
// USER & AUTHENTICATION
// ============================================================

model User {
  id           String     @id
  /// email, phone and nidNumber are UNIQUE among live rows via partial indexes
  /// Prisma cannot express (invisible to `migrate diff`; a --from-empty baseline
  /// drops them — docs/data-model.md):
  ///   users_email_live_key  UNIQUE (lower(email))  WHERE not rejected
  ///   users_phone_live_key  UNIQUE (phone)         WHERE not rejected
  ///   users_nid_live_key    UNIQUE ("nidNumber")   WHERE not rejected
  /// A rejected applicant may reapply, so two rows may share an email: every
  /// lookup by contact detail must exclude rejected applications.
  email        String?
  phone        String
  passwordHash String
  role         UserRole   @default(MEMBER)
  status       UserStatus @default(PENDING)

  /// Why an application was refused (FR-05): a code from lib/rejection-reasons.ts
  /// (kept forever) and an optional note (cleared by the retention sweep, ADR-033).
  rejectionReasonCode String?
  rejectionReasonNote String?
  rejectedAt          DateTime?

  /// The applicant's form language, for decision emails. Null before 2026-08-26.
  preferredLocale String?

  // Profile. accountNo (`ACC-KH-33001`) is the ONLY identifier a member is
  // given (ADR-023); called memberId before 2026-08-19.
  accountNo  String? @unique // গ্রাহক আই.ডি
  formNumber String? // ফরম নং

  // Personal Info
  nameEn        String // Name in English
  nameBn        String? // নাম (Bengali)
  fatherName    String // পিতার নাম
  motherName    String // মাতার নাম
  gender        Gender        @default(MALE)
  bloodGroup    String? // রক্তের গ্রুপ
  profession    String? // পেশা
  dateOfBirth   DateTime?
  maritalStatus MaritalStatus @default(UNMARRIED)
  childrenCount Int           @default(0) // সন্তানের সংখ্যা

  // NID Information
  nidNumber String? // এন.আই.ডি নং

  // Profile Picture
  avatarUrl String?

  // Timestamps
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  approvedAt     DateTime?
  approvedBy     String?
  approvedByUser User?     @relation("UserApprovals", fields: [approvedBy], references: [id])
  approvedUsers  User[]    @relation("UserApprovals")

  // Relations
  /// Both addresses in one relation, keyed (userId, type).
  addresses Address[]

  nominee                 Nominee?
  account                 Account?
  transactions            Transaction[]    @relation("UserTransactions")
  processedTransactions   Transaction[]    @relation("ProcessedTransactions")
  loans                   Loan[]           @relation("Borrower")
  guaranteedLoans         Loan[]           @relation("Guarantor")
  approvedLoans           Loan[]           @relation("ApprovedLoans")
  documents               Document[]
  supportThreads          SupportThread[]  @relation("MemberSupportThreads")
  processedSupportThreads SupportThread[]  @relation("ProcessedSupportThreads")
  supportMessages         SupportMessage[] @relation("SentSupportMessages")
  sseTickets              SseTicket[]      @relation("UserSseTickets")
  notifications           Notification[]   @relation("UserNotifications")

  /// The person's office — members' and workers' alike (WO-72). Nullable: set by
  /// the admin at approval; SetNull so closing an office deletes nobody.
  assignedBranch   Branch? @relation("AssignedBranch", fields: [assignedBranchId], references: [id], onDelete: SetNull)
  assignedBranchId String?

  /// Non-unique phone lookup (login and availability must find rejected rows too).
  @@index([phone])
  @@index([status, createdAt])
  @@index([role, status])
  @@index([approvedBy, approvedAt])
  @@index([approvedAt])
  @@index([assignedBranchId])
  @@map("users")
}

/// Which of a person's two addresses this row is.
enum AddressType {
  PERMANENT
  PRESENT
}

/// At most one of each kind per person, so (userId, type) is the key.
model Address {
  type          AddressType
  houseNo       String // বাড়ী নং
  roadNo        String? // রোড নং
  village       String // গ্রাম
  union         String // ইউনিয়ন
  policeStation String // থানা
  district      String // জেলা
  country       String      @default("বাংলাদেশ")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@id([userId, type])
  @@map("addresses")
}

/// The person who receives the account if the member dies — keyed on the member.
model Nominee {
  name         String // নমিনীর নাম
  relationship String // সম্পর্ক
  nidNumber    String // নমিনীর NID
  phone        String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @id

  @@map("nominees")
}

/// One uploaded file, keyed by owner and type (one of each per registration).
model Document {
  type     String // passport_photo, nid_front, nid_back, nominee_photo
  url      String
  fileName String
  mimeType String
  size     Int

  uploadedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Leads with userId, which is how both approval screens read this table.
  @@id([userId, type])
  @@map("documents")
}

// ============================================================
// FINANCIAL ACCOUNTS
// ============================================================

/// One account per user, keyed by the owner's id. No accountNumber — users.accountNo
/// is the one identifier (ADR-023).
model Account {
  // Balances (stored in Taka for precision)
  savingsBalance BigInt @default(0) // সঞ্চয় স্থিতি
  loanBalance    BigInt @default(0) // ঋণ স্থিতি

  /// No stored maxLoanAmount / isLoanEligible: derived from savingsBalance and
  /// loan.maxLoanMultiplier (money.MaxLoanAmount), so they cannot go stale.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The owner's id is the key (ADR-044).
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @id

  @@map("accounts")
}

/// One posting; the id IS the receipt number (DEP-/WDR-/DSB-/REP-/DON-/ADJ-),
/// allocated from document_sequences in the posting's transaction (ADR-044).
model Transaction {
  id          String          @id
  type        TransactionType
  amount      BigInt // Amount in Taka
  description String?

  /// The MEMBER's own reference (bKash TrxID), never the receipt number.
  externalReference String?

  status      TransactionStatus @default(PENDING)
  processedAt DateTime?
  confirmedAt DateTime?

  // Used for incorrect amount disputes.
  disputeReason        String?
  disputeCorrectAmount BigInt?

  // Balance snapshots after transaction
  savingsAfter BigInt?
  loanAfter    BigInt?

  createdAt DateTime @default(now())

  // Relations
  user   User   @relation("UserTransactions", fields: [userId], references: [id])
  userId String

  loan   Loan?   @relation(fields: [loanId], references: [id])
  loanId String?

  processedBy     String? // Worker ID who processed this transaction
  processedByUser User?   @relation("ProcessedTransactions", fields: [processedBy], references: [id])

  @@index([type, status, createdAt])
  @@index([status, createdAt])
  // A member's postings, newest first.
  @@index([userId, createdAt(sort: Desc)])
  @@index([processedBy, processedAt])
  // A loan's repayment history — loan_repository.GetLoanRepayments (WO-68).
  @@index([loanId])
  @@map("transactions")
}

// ============================================================
// LOANS
// ============================================================

/// One loan; the id IS the loan number (`LOAN-2026-000012`, ADR-044).
model Loan {
  id String @id

  // Loan Details
  principalAmount BigInt // ঋণের পরিমাণ (Taka)
  remainingAmount BigInt // ঋণ স্থিতি (Taka)

  // Installments
  totalInstallments Int // কিস্তির সংখ্যা
  installmentAmount BigInt // প্রতি কিস্তির পরিমাণ
  paidInstallments  Int    @default(0)

  // Dates
  disbursementDate     DateTime? // বিতরণের তারিখ
  installmentStartDate DateTime? // কিস্তি শুরুর তারিখ
  expectedEndDate      DateTime? // ঋণ পরিশোধের সম্ভাব্য তারিখ

  purpose        String? // গ্রহণের উদ্দেশ্য
  applicationFee BigInt  @default(0) // আবেদন ফি

  status LoanStatus @default(PENDING_GUARANTOR)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  approvedAt  DateTime?
  completedAt DateTime?

  // Relations
  borrower   User   @relation("Borrower", fields: [borrowerId], references: [id])
  borrowerId String

  guarantor   User?   @relation("Guarantor", fields: [guarantorId], references: [id])
  guarantorId String?

  transactions Transaction[]

  approvedBy     String?
  approvedByUser User?   @relation("ApprovedLoans", fields: [approvedBy], references: [id])

  @@index([status, createdAt])
  @@index([borrowerId, status])
  @@index([approvedBy, approvedAt])
  // WO-68: guarantorId is always filtered with status.
  @@index([guarantorId, status])
  @@map("loans")
}

// ============================================================
// SYSTEM
// ============================================================

/// A physical office; the code (`KH`) IS the primary key, set explicitly
/// (ADR-041). Account numbers do NOT derive from it — the ACC-KH-33 prefix is
/// fixed in account_no.go (ADR-008).
model Branch {
  id      String  @id
  name    String
  address String?
  phone   String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Everyone attached to this office — members and staff.
  users User[] @relation("AssignedBranch")

  @@index([isActive, name])
  @@map("branches")
}

/// The key IS the primary key.
model SystemConfig {
  key         String  @id
  value       String
  description String?

  updatedAt DateTime @updatedAt

  @@map("system_config")
}

/// The running number behind every reference (DEP-2026-000123), one row per
/// series per year, incremented in the posting's own transaction.
model DocumentSequence {
  series  String
  year    Int
  counter BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([series, year])
  @@map("document_sequences")
}

// DATA-08: a BEFORE UPDATE OR DELETE trigger makes this append-only (migration
// 20260816120000_audit_logs_append_only). Invisible to `migrate diff`; a
// --from-empty baseline WILL drop it. DELETE only with hasnahena.allow_audit_purge.
/// The trail, numbered by a sequence in insertion order. entityId is a readable
/// id (ACC-…, LOAN-…, DEP-…) since ADR-043/044.
model AuditLog {
  id         Int     @id @default(autoincrement())
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  details    String? // Additional details/notes

  userId    String? @map("performedBy") // Who performed the action
  userIp    String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, entityType, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// SUPPORT CHAT
// ============================================================

model SupportThread {
  id                String    @id
  memberUserId      String    @map("memberUserId")
  member            User      @relation("MemberSupportThreads", fields: [memberUserId], references: [id], onDelete: Cascade)
  status            String    @default("OPEN")
  processedByUserId String?   @map("processedByUserId")
  processedByUser   User?     @relation("ProcessedSupportThreads", fields: [processedByUserId], references: [id])
  processedAt       DateTime? @map("processedAt")
  deleteAt          DateTime  @map("deleteAt")
  createdAt         DateTime  @default(now()) @map("createdAt")
  updatedAt         DateTime  @updatedAt @map("updatedAt")

  messages SupportMessage[]

  @@index([memberUserId], map: "idx_support_threads_member")
  @@index([status, updatedAt(sort: Desc)], map: "idx_support_threads_status_updated")
  @@index([deleteAt], map: "idx_support_threads_delete_at")
  // Staff filtering their own processed threads (WO-68).
  @@index([processedByUserId])
  @@map("support_threads")
}

model SupportMessage {
  id           String        @id
  threadId     String        @map("threadId")
  thread       SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUserId String        @map("senderUserId")
  sender       User          @relation("SentSupportMessages", fields: [senderUserId], references: [id], onDelete: Cascade)
  message      String
  createdAt    DateTime      @default(now()) @map("createdAt")

  // One index; a btree scans both directions.
  @@index([threadId, createdAt], map: "idx_support_messages_thread_created")
  @@index([senderUserId, createdAt])
  @@map("support_messages")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationType {
  NEW_REGISTRATION
  LOAN_REQUEST
  WITHDRAWAL_REQUEST
  DEPOSIT_CONFIRMED
  LOAN_APPROVED
  LOAN_REJECTED
  ACCOUNT_ACTIVATED
  SYSTEM_ALERT
}

model Notification {
  /// Numbered. Nobody reads a notification's key, but the bell icon reads them
  /// newest-first and a sequence says so without a second column.
  id      Int              @id @default(autoincrement())
  type    NotificationType
  title   String
  message String
  data    Json? // Additional data for the notification

  // Target (who should see this)
  targetRole   UserRole? // If set, all users with this role see it
  /// WO-92: a real FK with cascade, so a notification can never name nobody.
  targetUserId String? // If set, specific user sees it
  targetUser   User?     @relation("UserNotifications", fields: [targetUserId], references: [id], onDelete: Cascade)

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([targetRole, isRead])
  @@index([targetUserId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// CONTENT MANAGEMENT
// ============================================================

model GalleryItem {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  captionEn String?
  captionBn String?
  date      DateTime @default(now())
  likes     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery_items")
}

// ============================================================
// PASSWORD RESET
// ============================================================

model PasswordResetToken {
  id String @id @default(cuid())

  // What the secret is for: "reset", "first-login" (derives mustChangePassword)
  // or "pwd-change:<userId>" (WO-86).
  scope String

  // SHA-256 of the emailed secret — never the secret.
  tokenHash String

  email String?
  phone String?

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  // Unique per (scope, hash): 6-digit codes can collide across members.
  @@unique([scope, tokenHash])
  @@index([email])
  @@index([phone])
  @@map("password_reset_tokens")
}

// ============================================================
// SECURITY: TOKEN BLACKLIST & RATE LIMITING
// ============================================================

model TokenBlacklist {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 hash of JWT (not the full token)
  userId    String
  reason    String   @default("logout") // logout, password_change, admin_revoke
  expiresAt DateTime // Same as JWT exp - for cleanup
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("token_blacklist")
}

// Short-lived single-purpose SSE credential (EventSource cannot send headers; SEC-05).
model SseTicket {
  ticketHash String   @id // SHA-256 hash of the ticket (not the ticket itself)
  userId     String
  user       User     @relation("UserSseTickets", fields: [userId], references: [id], onDelete: Cascade)
  purpose    String // e.g. "support_stream"
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt], map: "idx_sse_tickets_expires_at")
  // Tickets are issued and revoked per user (WO-68).
  @@index([userId])
  @@map("sse_tickets")
}

model RateLimit {
  id          String    @id // Format: "action:identifier" e.g., "login:user@example.com"
  attempts    Int       @default(1)
  lockedUntil DateTime?
  expiresAt   DateTime // For cleanup - TTL based
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt])
  @@map("rate_limits")
}
