# ===========================================================================
#  RENDER  —  Go API only  (apps/api). Vercel has its own store
#  (.env.vercel.example). A committed template: never put real values here.
#
#  Render and Vercel share exactly TWO values, byte for byte: DATABASE_URL and
#  JWT_SECRET. A mismatched JWT_SECRET = every login succeeds, then every
#  request 401s.
# ===========================================================================

# --- Required. The API refuses to boot without these. ----------------------
# Neon connection string. Use the POOLED url here (the -pooler host).
DATABASE_URL=

# Minimum 32 characters. Must be identical to the JWT_SECRET on Vercel.
JWT_SECRET=

# --- Set by Render automatically. Do not add these yourself. ----------------
# PORT                  Render injects it; the API prefers API_PORT, then PORT.
# RENDER_EXTERNAL_URL   Last-resort fallback for the public app URL.

# --- Required for the browser to reach the API -----------------------------
# Every calling origin, comma separated, no spaces, no trailing slash.
CORS_ORIGINS=https://hasnahenafoundation.com,https://www.hasnahenafoundation.com

# --- Public site URL, used in email links -----------------------------------
# Set ONLY this one of the many accepted aliases (first non-empty wins).
NEXT_PUBLIC_APP_URL=https://www.hasnahenafoundation.com

# --- Email (Brevo). Unset = email silently disabled. ------------------------
# Unset: approval/reset mails are skipped and /v1/health reports
# emailConfigured:false. EMAIL_FROM must be a Brevo-verified sender.
BREVO_API_KEY=
EMAIL_FROM=info@hasnahenafoundation.com
EMAIL_FROM_NAME=Hasnahena Foundation

# --- Optional. All have working defaults; omit unless you are tuning. -------

# debug | info | warn | error. JSON to stdout.
LOG_LEVEL=info

# SIGTERM drain. MUST be shorter than Render's stop grace period (default 30s)
# or Render SIGKILLs mid-drain.
SERVER_SHUTDOWN_TIMEOUT=25s

# HTTP server bounds. The SSE stream opts out of the write timeout itself.
SERVER_READ_HEADER_TIMEOUT=10s
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=120s

# Expired token_blacklist / rate_limits sweep. 0 disables. Daily: every tick
# wakes the (billed) database.
CLEANUP_INTERVAL=24h

# WO-82: ledger reconciliation — reports drift, never corrects it (ADR-027).
# Daily by the owner's ruling (cost). 0 only while a known drift is being
# corrected by hand; put it back.
RECONCILE_INTERVAL=24h

# SEC-09 HSTS. ON here, OFF locally (it would pin localhost to HTTPS for years).
ENABLE_HSTS=true

# RUN-07 / ADR-019: reverse proxies in front of this process — decides which
# X-Forwarded-For entry the limiter, access log, lockout and audit rows trust.
# Too low: callers pick their own bucket. Too high: forged entries are believed.
# Both silent — verify the access log's `ip` on a path NOT under
# /v1/dashboard/support/* (that one always shows Vercel; ADR-021).
# 3 since DNS moved to Cloudflare: origin, Cloudflare, Render.
TRUSTED_PROXIES=3

# Prefer CF-Connecting-IP (ADR-019, T-34) — true ONLY while every route to
# this process passes through your Cloudflare zone. The count stays the fallback.
TRUST_CLOUDFLARE_CLIENT_IP=true

# Per-client throttle on mutating requests (reads and health probes exempt).
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m

# Access token lifetime in seconds. Set the SAME value on Vercel.
JWT_EXPIRY_SECONDS=86400

# pgx pool. Keep MAX_CONNS under the Neon plan's limit. The idle end is the
# Neon bill (ADR-035): MIN_CONNS=0 lets the pool empty, and IDLE_TIME is
# shorter than Neon's 5-minute suspend timer. Keep the API warm with
# /v1/health, never /v1/ready. idle_cost_test.go fails if these drift.
DB_MAX_CONNS=25
DB_MIN_CONNS=0
DB_MAX_CONN_IDLE_TIME=60s
DB_MAX_CONN_LIFETIME=30m
DB_HEALTH_CHECK_PERIOD=5m

# --- Observability -------------------------------------------------------------
# Gates GET /metrics (unset = 404). Long random string; the monitor workflow
# needs the SAME value as the GitHub secret METRICS_TOKEN.
METRICS_TOKEN=

# Error tracking. Unset = disabled; the API boots normally.
SENTRY_DSN=

# Tags Sentry events. Falls back to RENDER_SERVICE_NAME, then "development".
ENVIRONMENT=production

# Floor between lazy business-gauge refreshes (on scrape), not a tick.
# METRICS_REFRESH_INTERVAL=10m

# --- Do NOT set these on Render ---------------------------------------------
# API_PORT — overrides Render's PORT; at worst a failed health check. Delete it.
# CLOUDINARY_* — the Go API never uses them (uploads are Next routes). Vercel only.
#
# --- NOT set here -----------------------------------------------------------
# Migrations and backups do not run on Render: DIRECT_DATABASE_URL / BACKUP_*
# are GitHub repository secrets (.github/workflows/backup.yml).
