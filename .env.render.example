# ===========================================================================
#  RENDER  —  Go API only  (apps/api)
# ===========================================================================
#  Paste these into the Render service's Environment tab. Nothing here is read
#  by the web app; Vercel has its own separate store (see .env.vercel.example).
#
#  Render and Vercel share exactly TWO values, and both must match byte for
#  byte: DATABASE_URL and JWT_SECRET. A mismatched JWT_SECRET means every
#  login succeeds and every following request 401s.
#
#  This file is a template. It is committed. Never put real values in it.
# ===========================================================================

# --- Required. The API refuses to boot without these. ----------------------
# Neon connection string. Use the POOLED url here (the -pooler host).
DATABASE_URL=

# Minimum 32 characters. Must be identical to the JWT_SECRET on Vercel.
JWT_SECRET=

# --- Set by Render automatically. Do not add these yourself. ----------------
# PORT                  Render injects it; the API prefers API_PORT, then PORT.
# RENDER_EXTERNAL_URL   Used as a last-resort fallback for the public app URL.

# --- Required for the browser to reach the API -----------------------------
# Every origin that calls this API, comma separated, no spaces, no trailing slash.
CORS_ORIGINS=https://hasnahenafoundation.com,https://www.hasnahenafoundation.com

# --- Public site URL, used in email links -----------------------------------
# Set ONE of these. The API accepts about a dozen aliases for historical
# reasons; NEXT_PUBLIC_APP_URL is the one to use. Do not set several — the
# first non-empty one in the resolver's list wins and that is easy to get
# wrong. If none are set it falls back to https://www.hasnahenafoundation.com.
NEXT_PUBLIC_APP_URL=https://www.hasnahenafoundation.com

# --- Email (Brevo). Unset = email silently disabled. ------------------------
# With these unset, approval and password-reset mails are skipped and
# /v1/health reports emailConfigured:false. Every other flow still works.
# EMAIL_FROM must be a Brevo-verified sender.
BREVO_API_KEY=
EMAIL_FROM=info@hasnahenafoundation.com
EMAIL_FROM_NAME=Hasnahena Foundation

# --- Optional. All have working defaults; omit unless you are tuning. -------

# debug | info | warn | error. The API logs JSON to stdout.
LOG_LEVEL=info

# How long SIGTERM waits for in-flight requests before giving up.
# MUST be shorter than Render's stop grace period, or Render SIGKILLs during
# the drain and the graceful shutdown buys nothing. Render's default grace is
# 30s, so keep this at 25s unless you raise the grace period.
SERVER_SHUTDOWN_TIMEOUT=25s

# HTTP server bounds. Raise SERVER_WRITE_TIMEOUT if a report or document
# endpoint starts timing out. The SSE stream opts out of it on its own.
SERVER_READ_HEADER_TIMEOUT=10s
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=120s

# How often expired token_blacklist and rate_limits rows are swept. 0 disables.
CLEANUP_INTERVAL=1h

# Access token lifetime in seconds.
JWT_EXPIRY_SECONDS=86400

# pgx pool. Keep MAX_CONNS under the Neon plan's connection limit.
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_MAX_CONN_IDLE_TIME=5m
DB_MAX_CONN_LIFETIME=30m
DB_HEALTH_CHECK_PERIOD=1m

# --- Do NOT set these on Render ---------------------------------------------
# API_PORT — Render assigns the port itself via PORT, and config.go already
#   reads `API_PORT` then falls back to `PORT`. Setting API_PORT overrides
#   Render's choice, which is at best redundant and at worst a failed health
#   check. Delete it.
#
# CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET — the Go
#   API contains zero Cloudinary references; uploads happen in the Next route
#   handlers. These belong on Vercel only. An API secret sitting in a store that
#   never reads it is exposure with no upside. Delete them here.
#
# --- NOT set here -----------------------------------------------------------
# Migrations and backups do not run on Render. `pnpm db:migrate` is run from a
# developer machine or CI, and the nightly dump is a GitHub Actions job, so
# DIRECT_DATABASE_URL / BACKUP_* belong in GitHub repository secrets — not here.
# See .github/workflows/backup.yml and docs/deployment.md.
