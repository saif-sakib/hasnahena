#!/usr/bin/env bash
#
# The checks that would otherwise only fail on Vercel or in CI (branch
# protection needs a paid plan on a private repo).
#
#   git config core.hooksPath .githooks   # install once
#   git push --no-verify                  # skip deliberately

set -uo pipefail

# GUI git clients (VS Code's Publish/Sync) do not read ~/.zshrc, so an
# nvm-installed pnpm is not on PATH — load nvm rather than misreport it.
if ! command -v pnpm >/dev/null 2>&1; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  for f in /usr/share/nvm/init-nvm.sh "$NVM_DIR/nvm.sh"; do
    [ -s "$f" ] && . "$f" >/dev/null 2>&1 && break
  done
fi
if ! command -v pnpm >/dev/null 2>&1; then
  echo
  echo "  ✗ pre-push: pnpm is not on PATH for this git client."
  echo "    Push from a terminal, or skip deliberately with:  git push --no-verify"
  echo
  exit 1
fi

# Nothing to check if only docs or config text changed. Keeps the common case fast.
# A new branch has no upstream yet, so compare it with origin/main.
CHANGED="$(git diff --name-only @{u}..HEAD 2>/dev/null || git diff --name-only origin/main...HEAD 2>/dev/null || echo '')"
if [ -n "$CHANGED" ] && ! echo "$CHANGED" | grep -qvE '^(docs/|README|CLAUDE\.md|\.env\..*example|.*\.md$)'; then
  echo "pre-push: documentation only — skipping build checks"
  exit 0
fi

fail() {
  echo
  echo "  ✗ pre-push: $1 failed."
  echo "    Fix it, or push anyway with:  git push --no-verify"
  echo
  exit 1
}

# Vercel installs frozen: the lockfile must match package.json.
echo "pre-push: lockfile…"
if ! pnpm install --frozen-lockfile --ignore-scripts >/dev/null 2>&1; then
  echo
  echo "  ✗ pnpm-lock.yaml does not match package.json."
  echo "    Fix with:  pnpm install && git add pnpm-lock.yaml && git commit --amend --no-edit"
  echo
  exit 1
fi

echo "pre-push: typecheck…"
pnpm typecheck >/dev/null 2>&1 || fail "pnpm typecheck"

# The build catches PostCSS/Tailwind breakage that typecheck misses.
echo "pre-push: build…"
BUILD_LOG="$(mktemp)"
if ! DATABASE_URL="${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/placeholder}" \
     pnpm build >"$BUILD_LOG" 2>&1; then
  tail -25 "$BUILD_LOG"
  rm -f "$BUILD_LOG"
  fail "pnpm build"
fi
rm -f "$BUILD_LOG"

if command -v go >/dev/null 2>&1; then
  echo "pre-push: go build…"
  (cd apps/api && go build ./...) || fail "go build"

  # vet, as CI does.
  echo "pre-push: go vet…"
  (cd apps/api && go vet ./...) || fail "go vet"
else
  echo "pre-push: go not installed — skipping Go build and vet (CI still checks both)"
fi

echo "pre-push: OK"
