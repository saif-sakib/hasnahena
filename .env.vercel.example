# ===========================================================================
#  VERCEL  —  Next.js web app only  (apps/web)
# ===========================================================================
#  Paste these into the Vercel project's Environment Variables. Nothing here
#  is read by the Go API; Render has its own separate store
#  (see .env.render.example).
#
#  Render and Vercel share exactly TWO values, and both must match byte for
#  byte: DATABASE_URL and JWT_SECRET.
#
#  NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so
#  changing one requires a redeploy, not just a restart. Never put a secret in
#  a NEXT_PUBLIC_ variable.
#
#  This file is a template. It is committed. Never put real values in it.
# ===========================================================================

# --- Required --------------------------------------------------------------
# Neon connection string, used by Prisma in the Next route handlers.
# Use the POOLED url (the -pooler host) for the app.
# `pnpm db:push` is the exception — that needs the DIRECT url.
DATABASE_URL=

# Must be identical to the JWT_SECRET on Render. The Next route handlers
# verify the same tokens the Go API issues.
JWT_SECRET=

# Where the browser sends API calls. Point it at the custom API domain, not
# the onrender.com hostname.
# REQUIRED. This is the only one the browser bundle can see — the
# NEXT_PUBLIC_ prefix is what inlines it at build time. `API_URL` is not a
# substitute: it is read by exactly one server-side route as a fallback, so
# with API_URL alone every dashboard call from the browser falls back to
# http://localhost:8081 and hits the member's own machine.
NEXT_PUBLIC_API_URL=https://api.hasnahenafoundation.com

# Canonical public site URL, used for SEO metadata and as the CORS fallback.
NEXT_PUBLIC_APP_URL=https://www.hasnahenafoundation.com
NEXT_PUBLIC_SITE_URL=https://www.hasnahenafoundation.com

# --- Required since the CORS lockdown --------------------------------------
# The Next route handlers /api/v1/gallery and /api/v1/settings used to answer
# Access-Control-Allow-Origin: *. They now check this list, the same one the
# Go API uses — but Vercel and Render are separate stores, so it has to be set
# in BOTH. If unset here it falls back to NEXT_PUBLIC_APP_URL, so the app
# keeps working; set it explicitly so the behaviour is not accidental.
CORS_ORIGINS=https://hasnahenafoundation.com,https://www.hasnahenafoundation.com

# --- Uploads (Cloudinary). Unset = uploads fail, everything else works. -----
# Server-side only. These are secrets — do not prefix them with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Set by Vercel automatically. Do not add these yourself. ----------------
# NODE_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL

# --- Observability (Batch E) -------------------------------------------------
# NEXT_PUBLIC_ because the browser bundle needs it too. A DSN is not a secret —
# it is a write-only ingest endpoint — but treat it as config, not as public.
# Unset = Sentry is inert and the build still succeeds.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Build-time only, for uploading source maps so stack traces are readable.
# Without SENTRY_AUTH_TOKEN the build still succeeds — it just warns and you
# get minified stack traces. Create the token in Sentry with project:releases.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- NOT set here -----------------------------------------------------------
# The Vercel build runs `prisma generate` and `next build` only; it never
# touches the schema. Migrations (`pnpm db:migrate`) run from a developer
# machine or CI, and backups run in GitHub Actions. So DIRECT_DATABASE_URL,
# SEED_ADMIN_* and BACKUP_* are not Vercel variables.
