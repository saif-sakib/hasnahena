# ===========================================================================
#  VERCEL  —  Next.js web app only  (apps/web). Render has its own store
#  (.env.render.example). A committed template: never put real values here.
#
#  Render and Vercel share exactly TWO values, byte for byte: DATABASE_URL and
#  JWT_SECRET. NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time —
#  changing one needs a redeploy, and a secret must never be NEXT_PUBLIC_.
# ===========================================================================

# --- Required --------------------------------------------------------------
# Neon connection string for Prisma in the Next route handlers — the POOLED
# url (-pooler host). Migrations use the DIRECT url and do not run on Vercel.
DATABASE_URL=

# Must be identical to the JWT_SECRET on Render (same tokens, both backends).
JWT_SECRET=

# Where the browser sends API calls — the custom API domain, not onrender.com.
# REQUIRED: the only API URL the browser bundle can see. `API_URL` is no
# substitute — without this every dashboard call goes to http://localhost:8081.
NEXT_PUBLIC_API_URL=https://api.hasnahenafoundation.com

# Canonical public site URL (SEO metadata, CORS fallback).
NEXT_PUBLIC_APP_URL=https://www.hasnahenafoundation.com
NEXT_PUBLIC_SITE_URL=https://www.hasnahenafoundation.com

# --- CORS ---------------------------------------------------------------------
# The same list as on Render (separate stores — set it in BOTH). Falls back to
# NEXT_PUBLIC_APP_URL if unset; set it explicitly.
CORS_ORIGINS=https://hasnahenafoundation.com,https://www.hasnahenafoundation.com

# --- Uploads (Cloudinary). Unset = uploads fail, everything else works. -----
# Server-side secrets — never NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- The nightly retention sweep (ADR-038) ----------------------------------
# Long random string; Vercel Cron sends it as `Authorization: Bearer <this>`
# (apps/web/vercel.json). Unset means NOBODY is accepted: the sweep never runs,
# refused applicants' ID scans stay online, and nothing says so.
CRON_SECRET=

# --- Set by Vercel automatically. Do not add these yourself. ----------------
# NODE_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL

# --- Observability -------------------------------------------------------------
# A DSN is a write-only ingest endpoint; the browser needs it. Unset = inert.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Build-time source-map upload (project:releases token). Unset = minified traces.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Content-Security-Policy (WO-76, ADR-024; policy in apps/web/lib/csp.ts) --
# Unset: Report-Only (violations go to the console, nothing breaks). Set to 1 to
# ENFORCE — only after a full `pnpm test:e2e` (incl. e2e/csp.spec.ts) is clean.
CSP_ENFORCE=

# --- NOT set here -----------------------------------------------------------
# The Vercel build runs `prisma generate` and `next build` only. Migrations run
# from a developer machine or CI, backups in GitHub Actions — so
# DIRECT_DATABASE_URL, SEED_ADMIN_* and BACKUP_* are not Vercel variables.
