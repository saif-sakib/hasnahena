{
  "name": "hasnahena",
  "version": "1.0.0",
  "private": true,
  "description": "Interest-free cooperative finance platform based on Islamic principles",
  "author": "Md Saif Ahmed <saifahmedsakib@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "sh -c 'API_PORT=${API_PORT:-8081}; export API_PORT; export NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:$API_PORT}; pnpm dev:api & pnpm dev:web'",
    "dev:web": "pnpm --filter @hasnahena/web dev",
    "dev:api": "cd apps/api && go run cmd/server/main.go",
    "build": "pnpm --filter @hasnahena/web build",
    "start": "pnpm --filter @hasnahena/web start",
    "lint": "pnpm --filter @hasnahena/web lint",
    "db:reset": "pnpm db:clear",
    "db:clear": "cd apps/web && node scripts/db-clear-preserve-core.mjs",
    "db:push": "pnpm --filter @hasnahena/web exec prisma db push",
    "db:migrate": "cd apps/web && node scripts/migrate.mjs deploy",
    "db:migrate:dev": "cd apps/web && node scripts/migrate.mjs dev",
    "db:migrate:status": "cd apps/web && node scripts/migrate.mjs status",
    "db:migrate:check": "cd apps/web && node scripts/migrate.mjs drift",
    "db:migrate:baseline": "cd apps/web && node scripts/migrate.mjs baseline",
    "db:seed": "cd apps/web && node scripts/seed.mjs",
    "db:backup": "scripts/backup.sh",
    "db:restore-check": "scripts/restore-check.sh",
    "db:studio": "pnpm --filter @hasnahena/web prisma studio",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "typecheck": "pnpm --filter @hasnahena/web typecheck",
    "test:e2e": "pnpm --filter @hasnahena/web test:e2e",
    "test:go": "cd apps/api && go test ./...",
    "test:integration": "cd apps/api && go test ./... -tags=integration -count=1 -p 1",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .next",
    "test:unit": "pnpm --filter @hasnahena/web test:unit",
    "test:routes": "pnpm --filter @hasnahena/web test:routes",
    "test:stack": "scripts/test-stack.sh",
    "test:stack:down": "scripts/test-stack.sh down"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.4",
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "glob@10": "^10.5.0",
      "js-yaml": "^4.3.1",
      "lodash": "^4.18.0",
      "nanoid@3": "^3.3.18",
      "picomatch@2": "^2.3.2",
      "postcss": "^8.5.23"
    }
  }
}
